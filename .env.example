# HomeServe — environment variables
# Copy this file to `.env` and fill in what you have.

# --- Clerk authentication (required for sign in / sign up) ---
# Grab a publishable key at https://dashboard.clerk.com and paste it below.
# Without it, the app runs in a read-only state: browsing works, but
# booking and favorites stay locked.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Firebase (Firestore for bookings + users) ---
# With no config, bookings are stored in localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- GeoDB Cities (free RapidAPI key: https://rapidapi.com/wirefreethought/api/geodb-cities) ---
# With no key, city search uses a built-in sample list.
VITE_GEO_DB_KEY=
