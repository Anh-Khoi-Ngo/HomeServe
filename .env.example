# HomeServe — environment variables
# Copy this file to `.env` and fill in what you have. Every value is optional —
# the app falls back to demo data (guest login, localStorage, sample cities)
# for anything that's missing, so it runs out of the box.

# --- Clerk authentication (https://dashboard.clerk.com) ---
# With no key, the app runs in demo mode with a guest login.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Firebase (Firestore for bookings + users) ---
# With no config, bookings are stored in localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- GeoDB Cities (free RapidAPI key: https://rapidapi.com/wirefreethought/api/geodb-cities) ---
# With no key, city search uses a built-in sample list.
VITE_GEO_DB_KEY=
